projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZEVER_M_TRAVEL_P //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use association _BOOKING { create; with draft; }

  use action setBooked;
  use action setDiscount;
  use action lineCopy;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Prepare;
  use action Resume;

}

define behavior for ZEVER_M_BOOKING_P //alias <alias_name>
{
  use update;
  use delete;

  use association _TRAVEL { with draft; }
}